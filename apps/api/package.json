{
  "name": "@parkguard/api",
  "version": "0.0.0",
  "private": true,
  "main": "build/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "rimraf ./build && tsc && tsc-alias",
    "start": "cross-env NODE_ENV=production node ./build/index.js",
    "orm": "typeorm-ts-node-commonjs -d ./src/db/data-source.ts",
    "orm:generate": "pnpm run orm migration:generate",
    "orm:create": "pnpm run orm migration:create",
    "orm:run": "pnpm run orm migration:run",
    "migration:run:prod": "typeorm --dataSource ./build/db/data-source.js migration:run",
    "orm:revert": "pnpm run orm migration:revert",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix --report-unused-disable-directives",
    "type-check": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests"
  },
  "dependencies": {
    "@parkguard/authorization": "workspace:*",
    "@parkguard/constants": "workspace:*",
    "@parkguard/schemas": "workspace:*",
    "@parkguard/types": "workspace:*",
    "@react-email/components": "1.0.12",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reflect-metadata": "^0.2.2",
    "resend": "6.17.2",
    "typeorm": "^1.0.0",
    "typeorm-naming-strategies": "4.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@parkguard/eslint-config": "workspace:*",
    "@parkguard/tsconfig": "workspace:*",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
